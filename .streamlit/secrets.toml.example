# ─────────────────────────────────────────────────────────────────────
#  PLANTILLA — copiá este archivo como  .streamlit/secrets.toml  y
#  reemplazá los valores. El secrets.toml real NO se sube al repo.
#  En Streamlit Community Cloud se pega en:  App → Settings → Secrets
# ─────────────────────────────────────────────────────────────────────

# ── 1. Login con Google (OAuth 2.0) ──────────────────────────────────
# Crear en Google Cloud Console → APIs y servicios → Credenciales →
# "ID de cliente de OAuth" → tipo "Aplicación web".
# En "URIs de redireccionamiento autorizados" agregar:
#   https://operation-un-scalalearning.streamlit.app/oauth2callback
#   http://localhost:8501/oauth2callback     (para pruebas locales)
[auth]
redirect_uri = "https://operation-un-scalalearning.streamlit.app/oauth2callback"
# cookie_secret: cualquier cadena larga aleatoria. Generar con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REEMPLAZAR_POR_CADENA_ALEATORIA_LARGA"

[auth.google]
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "xxxxxxxxxxxxxxxxxxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ── 2. Quién puede entrar ────────────────────────────────────────────
# Si se omite toda la sección [access], basta con iniciar sesión con
# cualquier cuenta de Google. Con [access], además el correo debe estar
# en 'emails' o pertenecer a un dominio de 'domains'.
[access]
emails = [
    "gcalderona@ucentral.edu.co",
    # "otra.persona@scalalearning.com",
]
# domains = ["scalalearning.com", "uniminuto.edu"]   # opcional
